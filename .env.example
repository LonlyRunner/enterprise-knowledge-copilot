APP_NAME=enterprise-knowledge-copilot
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE_MB=20
JWT_SECRET=replace-with-a-long-random-secret
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_LOCK_URL=redis://localhost:6379/2
REDIS_CACHE_URL=redis://localhost:6379/3
DEFAULT_TENANT_ID=default
AUTH_ENABLED=false
ACCESS_TOKEN_EXPIRE_MINUTES=120
VECTOR_STORE_BACKEND=postgres
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprise_document_chunks
OTEL_SERVICE_NAME=enterprise-knowledge-copilot
# Optional: set an OTLP HTTP endpoint to enable automatic tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
