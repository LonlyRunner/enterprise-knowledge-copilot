APP_NAME=enterprise-knowledge-copilot
DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_USE_LIFO=true
DB_COMMAND_TIMEOUT_SECONDS=60
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=2
LLM_TIMEOUT=60
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
DIAGNOSTICS_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_AUDIT_TTL_SECONDS=604800
GATEWAY_DEFAULT_MODE=auto
GATEWAY_DEFAULT_MODEL=project-c-router
MCP_SERVER_URL=http://mcp:8001/mcp
MCP_EXTERNAL_ENABLED=false
MCP_AUTH_TOKEN=replace-with-internal-service-token
MCP_HOST=0.0.0.0
MCP_PORT=8001
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE_MB=20
JWT_SECRET=replace-with-a-long-random-secret
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_LOCK_URL=redis://localhost:6379/2
REDIS_CACHE_URL=redis://localhost:6379/3
DEFAULT_TENANT_ID=default
AUTH_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=120
VECTOR_STORE_BACKEND=postgres
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=enterprise_document_chunks
OTEL_SERVICE_NAME=enterprise-knowledge-copilot
# Optional: set an OTLP HTTP endpoint to enable automatic tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
